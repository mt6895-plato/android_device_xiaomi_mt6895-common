# Allow system_server to read and write to sysfs_ged (GPU DVFS margin/step/boost etc)
allow system_server sysfs_ged:file rw_file_perms;

# Allow system_server to read and write to sysfs_dvfsrc_devfreq (DRAM userspace set_freq)
allow system_server sysfs_dvfsrc_devfreq:file rw_file_perms;

# Allow system_server to read and write to cpu_dma_latency_device
allow system_server cpu_dma_latency_device:chr_file rw_file_perms;