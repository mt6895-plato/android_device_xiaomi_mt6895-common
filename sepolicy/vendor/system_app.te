# FM Radio
get_prop(system_app, vendor_mtk_wmt_prop)
get_prop(system_app, vendor_mtk_default_prop)

# Thermal Access for XiaomiParts
allow system_app sysfs_therm:dir search;
allow system_app sysfs_therm:file rw_file_perms;

# CIT
allow system_app sysfs_power_supply:dir { read search };
allow system_app sysfs_power_supply:file r_file_perms;
allow system_app vendor_displayfeature_sysfs:file r_file_perms;
allow system_app vendor_torch_sysfs:file rw_file_perms;
allow system_app vendor_fingerprint_sysfs:file rw_file_perms;

allow system_app vendor_audio_data_file:dir { write add_name search read getattr };
allow system_app vendor_audio_data_file:file { read write create getattr append open lock };

allow system_app unlabeled:filesystem getattr;
